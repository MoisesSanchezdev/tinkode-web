---
import FinalCta from "../components/sections/FinalCta.astro";
import FounderCards from "../components/sections/FounderCards.astro";
import PageHero from "../components/sections/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const principles = [
	{ title: "Negocio antes que tecnología", text: "Construimos desde la necesidad real, no desde una herramienta de moda." },
	{ title: "Claridad en cada decisión", text: "El alcance, la interfaz y los siguientes pasos deben poder explicarse." },
	{ title: "Automatización con criterio", text: "Conectamos procesos solo cuando reduce una fricción concreta." },
] as const;
---

<BaseLayout
	title="Quiénes somos | TinKode"
	description="Conoce a Moisés Sánchez Naranjo y Valeria López Chávez, las personas detrás de TinKode y su enfoque de ingeniería aplicada."
	path="/nosotros"
>
	<PageHero
		eyebrow="Nosotros"
		title="Ingeniería aplicada a negocios reales."
		description="TinKode es una startup tecnológica colombiana que crea soluciones claras para mejorar la forma de trabajar."
	/>
	<FounderCards />
	<section class="section principles" aria-labelledby="principles-title">
		<div class="container">
			<div class="section-heading">
				<p class="eyebrow">Nuestro criterio</p>
				<h2 id="principles-title">Cómo tomamos decisiones</h2>
			</div>
			<div class="principles__list">
				{principles.map((principle) => <article><h3>{principle.title}</h3><p>{principle.text}</p></article>)}
			</div>
		</div>
	</section>
	<FinalCta title="Hablemos de tu negocio." description="Cuéntanos qué quieres mejorar." />
</BaseLayout>
