---
import FinalCta from "../components/sections/FinalCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import ProcessTimeline from "../components/sections/ProcessTimeline.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Proceso de diseño y desarrollo | TinKode"
	description="Así entiende, diseña, construye y hace evolucionar TinKode las soluciones tecnológicas para negocios."
	path="/proceso"
>
	<PageHero
		eyebrow="Proceso"
		title="De una necesidad a una solución clara."
		description="Ordenamos cada decisión antes de avanzar."
	/>
	<ProcessTimeline />
	<FinalCta title="No necesitas tener la solución." description="Empecemos por entender el problema." />
</BaseLayout>
