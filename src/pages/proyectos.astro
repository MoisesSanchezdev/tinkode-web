---
import FinalCta from "../components/sections/FinalCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import ProjectsShowcase from "../components/sections/ProjectsShowcase.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Proyectos de software e ingeniería | TinKode"
	description="Conoce proyectos reales de TinKode y sus fundadores en sistemas web, experiencias corporativas y conexiones NFC."
	path="/proyectos"
>
	<PageHero
		eyebrow="Proyectos"
		title="Trabajo que podemos explicar con claridad."
		description="Tres proyectos reales, presentados con su alcance y estado actual."
	/>
	<ProjectsShowcase />
	<FinalCta title="¿Tienes una necesidad parecida?" description="Conversemos sobre tu contexto." />
</BaseLayout>
