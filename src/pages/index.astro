---
import Hero from "../components/sections/Hero.astro";
import Problems from "../components/sections/Problems.astro";
import Process from "../components/sections/Process.astro";
import Solutions from "../components/sections/Solutions.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<Hero />
	<Problems />
	<Solutions />
	<Process />

	<section id="proyectos" class="future-section" aria-labelledby="future-title">
		<div class="container future-section__inner">
			<div>
				<p class="eyebrow">Siguientes bloques</p>
				<h2 id="future-title">Base preparada para proyectos, nosotros y contacto.</h2>
			</div>
			<div class="future-markers" aria-label="Secciones preparadas">
				<span>Proyectos</span>
				<a href="#nosotros">Nosotros</a>
				<a href="#contacto">Contacto</a>
			</div>
		</div>
	</section>

	<div id="nosotros" class="anchor-target" aria-hidden="true"></div>
	<div id="contacto" class="anchor-target" aria-hidden="true"></div>
</BaseLayout>
