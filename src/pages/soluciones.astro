---
import FinalCta from "../components/sections/FinalCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import SolutionsOverview from "../components/sections/SolutionsOverview.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Soluciones digitales para negocios | TinKode"
	description="Páginas, sistemas y automatizaciones creadas por TinKode para ordenar operaciones, facilitar el contacto y reducir tareas repetitivas."
	path="/soluciones"
>
	<PageHero
		eyebrow="Soluciones"
		title="Tecnología útil para tu negocio."
		description="Construimos la herramienta que tu operación necesita, sin forzarla dentro de un paquete genérico."
	/>
	<SolutionsOverview />
	<FinalCta title="¿Qué necesitas mejorar?" description="Empecemos por entenderlo." />
</BaseLayout>
