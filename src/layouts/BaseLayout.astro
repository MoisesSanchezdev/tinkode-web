---
import Footer from "../components/layout/Footer.astro";
import FloatingContact from "../components/layout/FloatingContact.astro";
import Header from "../components/layout/Header.astro";
import "../styles/global.css";
import "../styles/redesign.css";

interface Props {
	title?: string;
	description?: string;
	path?: string;
}

const SITE_URL = "https://tinkode-web.pages.dev";
const DEFAULT_TITLE = "TinKode | Tecnología para que los negocios funcionen mejor";
const DEFAULT_DESCRIPTION = "TinKode diseña software, automatización y experiencias digitales para que negocios y organizaciones resuelvan problemas reales.";
const OG_IMAGE = "/og.png";

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	path,
} = Astro.props as Props;

const pathname = path ?? Astro.url.pathname;
const canonicalUrl = new URL(pathname, SITE_URL).toString();
const imageUrl = new URL(OG_IMAGE, SITE_URL).toString();

const graph: Record<string, unknown>[] = [
	{
		"@type": "Organization",
		"@id": `${SITE_URL}/#organization`,
		name: "TinKode",
		url: SITE_URL,
		logo: new URL("/images/brand/tinkode-symbol.png", SITE_URL).toString(),
		description: DEFAULT_DESCRIPTION,
		sameAs: ["https://www.instagram.com/tinkode__/"],
		founder: [
			{ "@id": `${SITE_URL}/nosotros#moises-sanchez-naranjo` },
			{ "@id": `${SITE_URL}/nosotros#valeria-lopez-chavez` },
		],
	},
	{
		"@type": "WebSite",
		"@id": `${SITE_URL}/#website`,
		url: SITE_URL,
		name: "TinKode",
		inLanguage: "es-CO",
		publisher: { "@id": `${SITE_URL}/#organization` },
	},
];

if (pathname.startsWith("/soluciones")) {
	graph.push({
		"@type": "Service",
		"@id": `${SITE_URL}/soluciones#service`,
		name: "Soluciones tecnológicas para negocios",
		provider: { "@id": `${SITE_URL}/#organization` },
		areaServed: "Colombia",
		description,
		serviceType: ["Desarrollo web", "Automatización de procesos", "Software personalizado", "Integraciones", "Experiencias NFC"],
	});
}

if (pathname.startsWith("/nosotros")) {
	graph.push(
		{
			"@type": "Person",
			"@id": `${SITE_URL}/nosotros#moises-sanchez-naranjo`,
			name: "Moisés Sánchez Naranjo",
			jobTitle: "Fundador",
			worksFor: { "@id": `${SITE_URL}/#organization` },
		},
		{
			"@type": "Person",
			"@id": `${SITE_URL}/nosotros#valeria-lopez-chavez`,
			name: "Valeria López Chávez",
			jobTitle: "Cofundadora",
			worksFor: { "@id": `${SITE_URL}/#organization` },
		},
	);
}

const structuredData = { "@context": "https://schema.org", "@graph": graph };
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#05070b" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="TinKode: tecnología diseñada para que los negocios funcionen mejor" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:site_name" content="TinKode" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content="TinKode: tecnología diseñada para que los negocios funcionen mejor" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Saltar al contenido</a>
		<div class="site-root">
			<Header />
			<main id="main-content" tabindex="-1">
				<slot />
			</main>
			<Footer />
			<FloatingContact />
		</div>
	</body>
</html>
