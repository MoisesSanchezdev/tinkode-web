---
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import { PRIMARY_CONTACT_URL } from "../../data/contact";
import BrandLogo from "../ui/BrandLogo.astro";
const navItems = [
  { label: "Soluciones", href: "/soluciones" }, { label: "Proceso", href: "/proceso" },
  { label: "Proyectos", href: "/proyectos" }, { label: "Planes", href: "/#planes-negocios" },
  { label: "Nosotros", href: "/nosotros" },
];
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href === currentPath;
---
<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <BrandLogo />
    <nav class="site-nav" aria-label="Navegación principal"><ul>{navItems.map(item => <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul></nav>
    <div class="site-header__actions">
      <Button href={PRIMARY_CONTACT_URL} variant="secondary" size="small" external ariaLabel="Hablemos por WhatsApp">Hablemos <InlineIcon slot="icon-end" name="whatsapp" /></Button>
      <button class="menu-toggle" type="button" aria-label="Abrir menú principal" aria-controls="mobile-menu" aria-expanded="false" data-menu-toggle hidden><span aria-hidden="true"></span><span aria-hidden="true"></span></button>
    </div>
  </div>
  <noscript><nav class="fallback-nav container" aria-label="Navegación principal sin JavaScript">{navItems.map(item => <a href={item.href}>{item.label}</a>)}</nav></noscript>
  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
</header>
<dialog id="mobile-menu" class="mobile-nav" aria-label="Menú principal" data-mobile-menu>
  <div class="mobile-nav__head"><BrandLogo /><button class="menu-close" type="button" aria-label="Cerrar menú principal" data-menu-dismiss>×</button></div>
  <p class="eyebrow">Explora TinKode</p>
  <nav aria-label="Navegación móvil"><ul>{navItems.map((item,index) => <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}><small>0{index+1}</small>{item.label}<span aria-hidden="true">↗</span></a></li>)}</ul></nav>
  <Button href={PRIMARY_CONTACT_URL} external ariaLabel="Hablemos de tu negocio por WhatsApp">Hablemos de tu negocio <InlineIcon slot="icon-end" name="whatsapp" /></Button>
  <p class="mobile-nav__foot">Tecnología para que los negocios funcionen mejor.</p>
</dialog>
<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLDialogElement>("[data-mobile-menu]");
  if (header && toggle && menu) {
    toggle.hidden = false;
    const closeMenu = () => menu.close();
    toggle.addEventListener("click", () => {
      menu.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.body.classList.add("is-menu-open");
    });
    menu.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.body.classList.remove("is-menu-open");
      toggle.focus({ preventScroll: true });
    });
    menu.querySelectorAll("[data-menu-dismiss], a").forEach(item => item.addEventListener("click", closeMenu));
    menu.addEventListener("click", event => {
      if (event.target === menu) {
        const bounds = menu.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) closeMenu();
      }
    });
    window.matchMedia("(min-width: 1000px)").addEventListener("change", event => { if (event.matches && menu.open) closeMenu(); });
    const updateHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 16);
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  }
</script>
