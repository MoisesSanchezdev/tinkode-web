---
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";

const navItems = [
	{ label: "Soluciones", href: "/soluciones" },
	{ label: "Proyectos", href: "/proyectos" },
	{ label: "Planes", href: "/#planes-restaurantes" },
	{ label: "Proceso", href: "/proceso" },
	{ label: "Nosotros", href: "/nosotros" },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="site-footer__main">
			<div class="site-footer__brand">
				<a class="site-logo" href="/" aria-label="TinKode, inicio">
					<img src="/images/brand/tinkode-symbol.png" alt="" width="192" height="192" loading="lazy" decoding="async" />
					<span>TinKode</span>
				</a>
				<p>Tecnología clara para negocios que quieren avanzar.</p>
			</div>
			<nav aria-label="Navegación del pie de página">
				{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
			<a class="site-footer__instagram" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label={INSTAGRAM_LABEL}>Instagram</a>
		</div>
		<div class="site-footer__bottom">© {year} TinKode. Todos los derechos reservados.</div>
	</div>
</footer>
