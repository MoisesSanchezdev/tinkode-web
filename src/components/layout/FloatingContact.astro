---
import { PRIMARY_CONTACT_URL } from "../../data/contact";
import InlineIcon from "../ui/InlineIcon.astro";
---

<a class="floating-contact" href={PRIMARY_CONTACT_URL} target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp" data-floating-contact>
	<InlineIcon name="whatsapp" />
	<span>WhatsApp</span>
</a>

<script>
	const contact = document.querySelector("[data-floating-contact]");
	const plans = document.querySelector("#planes-negocios");
	if (contact instanceof HTMLElement && plans instanceof HTMLElement && "IntersectionObserver" in window) {
		const observer = new IntersectionObserver(([entry]) => {
			contact.classList.toggle("is-hidden", Boolean(entry?.isIntersecting));
		}, { threshold: 0.04 });
		observer.observe(plans);
	}
</script>
