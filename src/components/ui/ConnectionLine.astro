---
interface Props {
	variant?: "green" | "blue" | "mixed";
	direction?: "horizontal" | "vertical";
	class?: string;
}

const {
	variant = "mixed",
	direction = "horizontal",
	class: className,
} = Astro.props as Props;

const classes = [
	"tk-connection-line",
	`tk-connection-line--${variant}`,
	`tk-connection-line--${direction}`,
	className,
];
---

<span class:list={classes} aria-hidden="true"></span>
