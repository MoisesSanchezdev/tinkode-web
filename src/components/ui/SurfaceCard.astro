---
interface Props {
	as?: "article" | "section" | "div" | "aside";
	interactive?: boolean;
	padding?: "compact" | "normal" | "spacious";
	class?: string;
}

const {
	as: Tag = "article",
	interactive = false,
	padding = "normal",
	class: className,
} = Astro.props as Props;

const classes = [
	"tk-surface-card",
	`tk-surface-card--${padding}`,
	interactive && "tk-surface-card--interactive",
	className,
];
---

<Tag class:list={classes}>
	<slot />
</Tag>
