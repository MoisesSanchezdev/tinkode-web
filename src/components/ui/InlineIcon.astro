---
type IconName = "automation" | "interface" | "website" | "arrow" | "shield" | "message" | "whatsapp";

interface Props {
	name: IconName;
	label?: string;
	class?: string;
}

const { name, label, class: className } = Astro.props as Props;

const paths: Record<IconName, string> = {
	automation: '<path d="M7 12a5 5 0 0 1 8.8-3.2" /><path d="M17 5v4h-4" /><path d="M17 12a5 5 0 0 1-8.8 3.2" /><path d="M7 19v-4h4" />',
	interface: '<path d="M4 6h16v12H4z" /><path d="M4 10h16" /><path d="M8 14h4" /><path d="M15 14h2" />',
	website: '<path d="M4 6h16v12H4z" /><path d="M4 10h16" /><path d="M8 14h3" /><path d="M14 14h2" />',
	arrow: '<path d="M5 12h14" /><path d="m13 6 6 6-6 6" />',
	shield: '<path d="M12 3 5 6v5c0 4.4 2.8 8.4 7 10 4.2-1.6 7-5.6 7-10V6z" /><path d="m9.5 12 1.8 1.8 3.4-4" />',
	message: '<path d="M5 6h14v10H9l-4 4z" /><path d="M9 10h6" /><path d="M9 13h4" />',
	whatsapp: '<path d="M5.5 18.5 6.4 15A7 7 0 1 1 9 17.6z" /><path d="M9.5 8.8c.3 2 1.8 3.6 3.7 4.2" /><path d="M13.6 13.1h.1" /><path d="M9.4 8.8h.1" />',
};
---

<svg
	class:list={["inline-icon", className]}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={label ? undefined : "true"}
	role={label ? "img" : undefined}
	aria-label={label}
	set:html={paths[name]}
/>
