---
interface Props {
	as?: "section" | "div";
	variant?: "grid" | "glow-green" | "glow-blue" | "mixed" | "none";
	class?: string;
	id?: string;
	ariaLabelledby?: string;
}

const {
	as: Tag = "section",
	variant = "grid",
	class: className,
	id,
	ariaLabelledby,
} = Astro.props as Props;

const classes = [
	"tk-section-bg",
	`tk-section-bg--${variant}`,
	className,
];
---

<Tag class:list={classes} id={id} aria-labelledby={ariaLabelledby}>
	<span class="tk-section-bg__visual" aria-hidden="true"></span>
	<slot />
</Tag>
