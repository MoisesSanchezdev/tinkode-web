---
interface Props {
	as?: "article" | "section" | "div" | "aside";
	variant?: "neutral" | "green" | "blue" | "mixed";
	interactive?: boolean;
	padding?: "compact" | "normal" | "spacious";
	class?: string;
}

const {
	as: Tag = "article",
	variant = "neutral",
	interactive = false,
	padding = "normal",
	class: className,
} = Astro.props as Props;

const classes = [
	"tk-visual-card",
	`tk-visual-card--${variant}`,
	`tk-visual-card--${padding}`,
	interactive && "tk-visual-card--interactive",
	className,
];
---

<Tag class:list={classes}>
	<slot />
</Tag>
