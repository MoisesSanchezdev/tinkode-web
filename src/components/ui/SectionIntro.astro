---
interface Props {
	eyebrow: string;
	title: string;
	description?: string;
	titleId: string;
	align?: "start" | "center";
	class?: string;
}

const {
	eyebrow,
	title,
	description,
	titleId,
	align = "start",
	class: className,
} = Astro.props as Props;
---

<header class:list={["v2-section-intro", `v2-section-intro--${align}`, className]}>
	<p class="v2-eyebrow">{eyebrow}</p>
	<h2 id={titleId}>{title}</h2>
	{description && <p>{description}</p>}
</header>
