---
interface Props {
	variant?: "green" | "blue";
	size?: "sm" | "md" | "lg";
	label?: string;
	decorative?: boolean;
	class?: string;
}

const {
	variant = "green",
	size = "md",
	label,
	decorative = !label,
	class: className,
} = Astro.props as Props;

const classes = [
	"tk-glow-icon",
	`tk-glow-icon--${variant}`,
	`tk-glow-icon--${size}`,
	className,
];
---

<span class:list={classes} aria-hidden={decorative ? "true" : undefined} aria-label={!decorative ? label : undefined} role={!decorative ? "img" : undefined}>
	<slot />
</span>
