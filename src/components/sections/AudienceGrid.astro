---
import { audiences } from "../../data/site";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionIntro from "../ui/SectionIntro.astro";
---

<section class="v2-section v2-audiences" aria-labelledby="v2-audiences-title">
	<div class="container">
		<SectionIntro
			eyebrow="Negocios"
			title="Tecnología útil para operaciones reales."
			description="Trabajamos con equipos y emprendimientos que quieren ahorrar tiempo, ordenar información y ofrecer una experiencia más clara."
			titleId="v2-audiences-title"
		/>
		<ul class="v2-audiences__grid">
			{audiences.map((audience) => <li><InlineIcon name={audience.icon} /><span>{audience.label}</span></li>)}
		</ul>
	</div>
</section>
