---
import { projects } from "../../data/site";
import InlineIcon from "../ui/InlineIcon.astro";

interface Props {
	home?: boolean;
}

const { home = false } = Astro.props as Props;
---

<section id="proyectos" class="section projects-showcase" aria-labelledby="projects-showcase-title">
	<div class="container">
		<div class="section-heading">
			<p class="eyebrow">Trabajo real</p>
			<h2 id="projects-showcase-title">{home ? "Proyectos seleccionados" : "Tres proyectos reales"}</h2>
			{!home && <p>Software, experiencias web y conexiones físico-digitales presentadas con su estado real.</p>}
		</div>

		<div class:list={["projects-grid", !home && "projects-grid--detailed"]}>
			{
				projects.map((project) => (
					<article id={project.id} class="project-card">
						<div class="project-card__visual">
							{project.visual === "competition" && (
								<div class="competition-visual" aria-label="Representación conceptual del sistema Robot Explota Globos">
									<span>UTP</span>
									<div><strong>08</strong><i></i><strong>06</strong></div>
									<small>Gestión de competencia</small>
								</div>
							)}
							{project.visual === "website" && (
								<div class="website-visual" aria-label="Representación conceptual del sitio corporativo LPT">
									<div><span></span><span></span><span></span></div>
									<strong>LPT</strong>
									<small>Servicios empresariales</small>
								</div>
							)}
							{project.visual === "nfc" && (
								<img
									src="/images/projects/nfc/nfc-experience.webp"
									alt="Etiqueta NFC conectando un objeto físico con una experiencia digital en un celular."
									width="1000"
									height="1010"
									loading="lazy"
									decoding="async"
								/>
							)}
						</div>

						<div class="project-card__content">
							<div class="project-card__meta">
								<span>{project.category}</span>
								{!home && <small>{project.status}</small>}
							</div>
							<h3>{project.name}</h3>
							<p>{project.summary}</p>
							{home ? (
								<a class="text-link" href={`/proyectos#${project.id}`}>Ver proyecto <InlineIcon name="arrow" /></a>
							) : (
								<>
									<ul class="tag-list" aria-label={`Tecnologías de ${project.name}`}>
										{project.technologies.map((technology) => <li>{technology}</li>)}
									</ul>
									<p class="project-card__note"><InlineIcon name="shield" />{project.note}</p>
								</>
							)}
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
