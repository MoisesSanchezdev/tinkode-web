---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import ConnectionLine from "../ui/ConnectionLine.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import TechNode from "../ui/TechNode.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";

const projectTypes = [
	{
		title: "Sistema administrativo",
		description: "Reglas, datos y operación",
		icon: "interface",
		nodes: ["Competencia", "Ganadores", "Correcciones"],
		variant: "green",
	},
	{
		title: "Experiencia web",
		description: "Servicios, navegación y contenido",
		icon: "website",
		nodes: ["Servicios", "Responsive", "Contacto"],
		variant: "blue",
	},
	{
		title: "Interacción NFC",
		description: "Objeto físico a experiencia digital",
		icon: "nfc",
		nodes: ["Toque", "Contenido", "Acción"],
		variant: "green",
	},
] as const;
---

<SectionBackground as="section" variant="mixed" class="projects-hero" ariaLabelledby="projects-hero-title">
	<div class="container projects-hero__grid">
		<div class="projects-hero__content">
			<Badge variant="accent">Proyectos y experiencias</Badge>
			<div class="projects-hero__copy">
				<h1 id="projects-hero-title">Construimos soluciones alrededor de problemas reales.</h1>
				<p>
					Cada proyecto combina análisis, diseño y tecnología para resolver una necesidad específica.
				</p>
			</div>
			<div class="projects-hero__actions" aria-label="Acciones principales">
				<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>Hablemos</Button>
				<Button href="/proceso" variant="ghost" size="large">Conocer nuestro proceso</Button>
			</div>
		</div>

		<div class="projects-hero-visual" aria-label="Colección conceptual de tres tipos de proyectos construidos">
			{
				projectTypes.map((project, index) => (
					<article class:list={["projects-hero-visual__layer", `projects-hero-visual__layer--${project.variant}`]}>
						<div class="projects-hero-visual__header">
							<TechNode label={project.title} variant={project.variant} size="sm" active={index === 0}>
								<InlineIcon slot="icon" name={project.icon} />
							</TechNode>
							<span>{project.description}</span>
						</div>
						<div class="projects-hero-visual__nodes">
							{project.nodes.map((node) => <span>{node}</span>)}
						</div>
						{index < projectTypes.length - 1 && <ConnectionLine class="projects-hero-visual__line" variant="mixed" />}
					</article>
				))
			}
		</div>
	</div>
</SectionBackground>
