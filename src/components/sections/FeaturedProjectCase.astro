---
import GlowIcon from "../ui/GlowIcon.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import TechNode from "../ui/TechNode.astro";
import CompetitionSystemMockup from "./CompetitionSystemMockup.astro";

const capabilities = [
	"Gestión de competencia",
	"Lógica de negocio",
	"Administración editable",
	"Persistencia de datos",
	"Interacciones AJAX",
	"Validaciones",
	"Documentación técnica",
] as const;

const technologies = ["Python", "Django", "HTML", "CSS", "JavaScript", "Bases de datos", "Git"] as const;
---

<SectionBackground as="section" variant="glow-green" class="projects-featured projects-page-section" ariaLabelledby="project-robot-title">
	<div class="container projects-featured__grid">
		<Reveal class="projects-featured__copy">
			<div class="projects-case__label">
				<GlowIcon variant="green" size="md">
					<InlineIcon name="workflow" />
				</GlowIcon>
				<span>Proyecto destacado</span>
			</div>
			<div>
				<p class="eyebrow">Sistema universitario de gestión de competencia</p>
				<h2 id="project-robot-title">Robot Explota Globos UTP</h2>
				<p>
					Plataforma desarrollada para administrar un torneo universitario real en la Universidad Tecnológica de Pereira.
				</p>
			</div>
			<div class="projects-case__story">
				<div>
					<span>Problema</span>
					<p>Administrar una competencia con múltiples categorías, fases y correcciones operativas durante el evento.</p>
				</div>
				<div>
					<span>Solución</span>
					<p>Una plataforma web personalizada para controlar participantes, grupos, batallas, ganadores y ajustes manuales sin perder el progreso.</p>
				</div>
				<div>
					<span>Estado</span>
					<p>En preparación y pruebas para torneo universitario.</p>
				</div>
			</div>
		</Reveal>

		<Reveal class="projects-featured__visual" delay="sm">
			<CompetitionSystemMockup />
		</Reveal>

		<div class="projects-featured__details">
			<div class="projects-chip-list" aria-label="Capacidades demostradas en Robot Explota Globos">
				{capabilities.map((item) => <span>{item}</span>)}
			</div>
			<div class="projects-tech-list" aria-label="Tecnologías mostradas en Robot Explota Globos">
				{technologies.map((item, index) => (
					<TechNode label={item} variant={index % 2 === 0 ? "green" : "blue"} size="sm" />
				))}
			</div>
		</div>
	</div>
</SectionBackground>
