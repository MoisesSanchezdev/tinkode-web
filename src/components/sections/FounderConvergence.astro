---
import ConnectionLine from "../ui/ConnectionLine.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechNode from "../ui/TechNode.astro";

const electronic = ["Integración", "Automatización", "Sistemas físico-digitales", "Análisis técnico"];
const systems = ["Arquitectura", "Software", "Organización", "Experiencias digitales"];
---

<SectionBackground variant="glow-blue" class="about-page-section about-convergence" ariaLabelledby="about-convergence-title">
	<div class="container about-convergence__grid">
		<Reveal class="about-convergence__copy">
			<SectionHeading
				eyebrow="Como se complementan"
				title="Ingeniería electrónica e ingeniería de sistemas se encuentran en el problema."
				titleId="about-convergence-title"
				description="TinKode combina ingeniería, software y una visión práctica de los procesos para que la tecnología no sea decoración, sino una herramienta de trabajo."
			/>
		</Reveal>

		<Reveal class="about-convergence__map" delay="sm">
			<div class="about-convergence__lane about-convergence__lane--green">
				<span>Electrónica</span>
				{electronic.map((item) => <TechNode label={item} variant="green" size="sm" />)}
			</div>

			<div class="about-convergence__center" aria-label="Interseccion TinKode">
				<ConnectionLine variant="green" />
				<strong>TinKode</strong>
				<p>Soluciones tecnológicas diseñadas alrededor de problemas reales.</p>
				<ConnectionLine variant="blue" />
			</div>

			<div class="about-convergence__lane about-convergence__lane--blue">
				<span>Sistemas</span>
				{systems.map((item) => <TechNode label={item} variant="blue" size="sm" />)}
			</div>
		</Reveal>
	</div>
</SectionBackground>
