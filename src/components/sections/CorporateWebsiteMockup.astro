---
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechNode from "../ui/TechNode.astro";
import VisualCard from "../ui/VisualCard.astro";

const capabilities = [
	"Arquitectura de información",
	"Desarrollo responsive",
	"Diseño de interfaz",
	"Navegación",
	"Comunicación corporativa",
	"Organización de contenido",
] as const;

const technologies = ["Python", "Django", "HTML", "CSS", "JavaScript", "Git"] as const;
---

<section class="projects-lpt projects-page-section" aria-labelledby="project-lpt-title">
	<div class="container projects-lpt__grid">
		<Reveal class="projects-lpt__visual">
			<VisualCard variant="blue" class="lpt-mockup" as="div">
				<div class="lpt-mockup__bar" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</div>
				<div class="lpt-mockup__hero">
					<strong>LPT</strong>
					<p>Servicios organizados en una experiencia corporativa clara.</p>
				</div>
				<div class="lpt-mockup__services" aria-hidden="true">
					<span>Aseo</span>
					<span>Movilidad vertical</span>
					<span>Contacto</span>
				</div>
				<div class="lpt-mockup__sections" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</div>
			</VisualCard>
		</Reveal>

		<Reveal class="projects-lpt__copy" delay="sm">
			<SectionHeading
				eyebrow="Experiencia web corporativa"
				title="LPT"
				description="Sitio corporativo desarrollado antes de la creación formal de TinKode y presentado como experiencia previa de uno de sus fundadores."
				titleId="project-lpt-title"
			/>
			<div class="projects-case__story">
				<div>
					<span>Problema</span>
					<p>Organizar diferentes líneas de servicio dentro de una presencia digital clara y profesional.</p>
				</div>
				<div>
					<span>Solución</span>
					<p>Una experiencia web corporativa con navegación estructurada, presentación de servicios y llamados a la acción.</p>
				</div>
				<div>
					<span>Estado</span>
					<p>Proyecto previo a TinKode, con código privado.</p>
				</div>
			</div>
			<div class="projects-chip-list" aria-label="Capacidades demostradas en LPT">
				{capabilities.map((item) => <span>{item}</span>)}
			</div>
			<div class="projects-tech-list" aria-label="Tecnologías mostradas en LPT">
				{technologies.map((item, index) => (
					<TechNode label={item} variant={index % 2 === 0 ? "blue" : "green"} size="sm" />
				))}
			</div>
		</Reveal>
	</div>
</section>
