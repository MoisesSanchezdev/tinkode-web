---
import { processSteps } from "../../data/site";
import Button from "../ui/Button.astro";
import SectionIntro from "../ui/SectionIntro.astro";

interface Props {
	home?: boolean;
	detailed?: boolean;
}

const { home = false, detailed = false } = Astro.props as Props;
---

<section id="proceso" class="v2-section v2-process" aria-labelledby="v2-process-title">
	<div class="container">
		<div class="v2-section-heading-row">
			<SectionIntro
				eyebrow="Proceso"
				title="Primero entendemos. Después construimos."
				description="No necesitas llegar con la solución definida. Diseñamos el recorrido contigo y validamos cada decisión importante."
				titleId="v2-process-title"
			/>
			{home && <Button href="/proceso" variant="secondary">Conocer el proceso</Button>}
		</div>

		<ol class="v2-process__steps">
			{
				processSteps.map((step, index) => (
					<li>
						<div class="v2-process-step__number"><span>{step.number}</span>{index < processSteps.length - 1 && <i aria-hidden="true"></i>}</div>
						<div class="v2-process-step__body">
							<h3>{step.title}</h3>
							<p>{step.description}</p>
							{detailed && <small>{step.deliverable}</small>}
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
