---
import { processSteps } from "../../data/site";
---

<section class="section process-timeline" aria-labelledby="process-timeline-title">
	<div class="container">
		<div class="section-heading">
			<p class="eyebrow">Método</p>
			<h2 id="process-timeline-title">Cuatro pasos, una ruta clara</h2>
		</div>

		<ol>
			{
				processSteps.map((step) => (
					<li>
						<span>{step.number}</span>
						<div><h3>{step.title}</h3><p>{step.description}</p></div>
					</li>
				))
			}
		</ol>
	</div>
</section>
