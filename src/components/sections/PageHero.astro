---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props as Props;
---

<section class="page-hero" aria-labelledby="page-hero-title">
	<div class="container page-hero__inner">
		<a class="page-hero__back" href="/">TinKode <span aria-hidden="true">/</span></a>
		<p class="eyebrow">{eyebrow}</p>
		<h1 id="page-hero-title" data-hero-reveal>{title}</h1>
		<p>{description}</p>
		<span class="page-hero__mark" aria-hidden="true">↗</span>
	</div>
</section>
