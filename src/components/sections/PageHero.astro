---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props as Props;
---

<section class="page-hero" aria-labelledby="page-hero-title">
	<div class="container">
		<p class="eyebrow">{eyebrow}</p>
		<h1 id="page-hero-title">{title}</h1>
		<p>{description}</p>
	</div>
</section>
