---
import Button from "../ui/Button.astro";
import ConnectionLine from "../ui/ConnectionLine.astro";
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import VisualCard from "../ui/VisualCard.astro";

const principles = [
	{
		number: "01",
		title: "Entendemos antes de construir",
		description: "Primero aclaramos el problema y la operación real.",
	},
	{
		number: "02",
		title: "Diseñamos alrededor del negocio",
		description: "La solución se adapta al flujo, no al revés.",
	},
	{
		number: "03",
		title: "Construimos para evolucionar",
		description: "Cada modulo debe poder crecer con orden.",
	},
	{
		number: "04",
		title: "Comunicamos de forma directa",
		description: "Decisiones claras, avances visibles y menos ruido.",
	},
];
---

<section class="home-principles home-section" aria-labelledby="home-principles-title">
	<div class="container">
		<div class="home-principles__header">
			<SectionHeading
				eyebrow="Ingeniería"
				title="No vendemos software. Diseñamos cómo funcionan los negocios."
				description="El enfoque combina criterio técnico, claridad operativa y acompañamiento directo."
				titleId="home-principles-title"
			/>
			<Button href="/proceso" variant="ghost">Conocer proceso</Button>
		</div>

		<ol class="home-principles__list">
			{
				principles.map((principle, index) => (
					<Reveal as="li" delay={index > 1 ? "sm" : "none"}>
						<VisualCard class="principle-card" variant={index % 2 === 0 ? "green" : "blue"}>
							<span class="principle-card__number">{principle.number}</span>
							<div>
								<h3>{principle.title}</h3>
								<p>{principle.description}</p>
							</div>
							{index < principles.length - 1 && <ConnectionLine class="principle-card__line" />}
						</VisualCard>
					</Reveal>
				))
			}
		</ol>
	</div>
</section>
