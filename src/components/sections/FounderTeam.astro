---
import FounderProfileCard from "./FounderProfileCard.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const founders = [
	{
		initials: "MS",
		name: "Moisés Sánchez Naranjo",
		role: "Fundador",
		study: "Estudiante de Ingeniería Electrónica",
		institution: "Universidad Tecnológica de Pereira",
		description: "Aporta pensamiento de ingeniería, criterio técnico y una mirada orientada a conectar software, automatización e integración hardware-software.",
		focus: ["Desarrollo de software", "Automatización", "Integración", "Diseño de sistemas"],
		variant: "green",
	},
	{
		initials: "VL",
		name: "Valeria López Chávez",
		role: "Cofundadora",
		study: "Estudiante de Ingeniería de Sistemas",
		institution: "Universidad Tecnológica de Pereira",
		description: "Aporta estructura, organización de soluciones y una visión enfocada en construir software claro, útil y coherente con la experiencia digital.",
		focus: ["Desarrollo de software", "Arquitectura", "Experiencias digitales", "Organización"],
		variant: "blue",
	},
] as const;
---

<SectionBackground variant="mixed" class="about-page-section about-founders-premium" ariaLabelledby="about-founders-title">
	<div class="container">
		<Reveal class="about-founders-premium__heading">
			<SectionHeading
				eyebrow="Equipo fundador"
				title="Dos perfiles de ingeniería con una misma exigencia: resolver con claridad."
				titleId="about-founders-title"
				description="TinKode no se presenta como una estructura corporativa inflada. Su base está en la participación directa de quienes piensan, diseñan y construyen cada solución."
			/>
		</Reveal>

		<div class="about-founders-premium__grid">
			{founders.map((founder, index) => <Reveal delay={index === 0 ? "sm" : "md"}><FounderProfileCard {...founder} /></Reveal>)}
		</div>
	</div>
</SectionBackground>
