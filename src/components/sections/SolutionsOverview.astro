---
import { solutionCategories } from "../../data/site";
import { PRIMARY_CONTACT_URL } from "../../data/contact";
import InlineIcon from "../ui/InlineIcon.astro";
import CapabilityDiagram from "../ui/CapabilityDiagram.astro";
---
<section class="section solutions-overview" aria-labelledby="solutions-overview-title">
  <div class="container">
    <h2 id="solutions-overview-title" class="sr-only">Nuestras capacidades</h2>
    <div class="solutions-overview__list">
      {solutionCategories.map((solution, index) => <article id={`solucion-${index}`} class="solution-row" data-reveal>
        <div class="solution-row__content"><p class="eyebrow">0{index + 1} / Solución</p><h3>{solution.title}</h3><p>{solution.description}</p><div class="solution-row__scope"><span>Qué podemos construir</span><p>{solution.scope}</p></div><a class="text-link" href={PRIMARY_CONTACT_URL} target="_blank" rel="noopener noreferrer" aria-label={`Hablemos de esta solución: ${solution.title}, por WhatsApp`}>Hablemos de esta solución <InlineIcon name="whatsapp" /></a></div>
        <CapabilityDiagram variant={index} />
      </article>)}
    </div>
    <div class="custom-solution" data-reveal><InlineIcon name="interface" /><div><h3>Tu operación no tiene por qué encajar en un molde.</h3><p>Inventarios, dashboards, formularios, agendamiento e integraciones. Primero entendemos tu proceso; después definimos la herramienta.</p></div><a class="text-link" href="/proceso">Conoce el proceso <InlineIcon name="arrow" /></a></div>
  </div>
</section>
