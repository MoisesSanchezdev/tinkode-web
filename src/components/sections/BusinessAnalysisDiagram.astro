---
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechNode from "../ui/TechNode.astro";

const analysisItems = [
	{ title: "Problemas", description: "Qué frena la operación.", icon: "control", variant: "green" },
	{ title: "Procesos", description: "Cómo fluye el trabajo real.", icon: "workflow", variant: "blue" },
	{ title: "Personas", description: "Quién participa y decide.", icon: "users", variant: "green" },
	{ title: "Información", description: "Dónde nacen y viven los datos.", icon: "database", variant: "blue" },
	{ title: "Eficiencia", description: "Qué se puede simplificar.", icon: "automation", variant: "green" },
] as const;
---

<SectionBackground as="section" variant="glow-blue" class="process-analysis process-page-section" ariaLabelledby="process-analysis-title">
	<div class="container process-analysis__grid">
		<div class="process-analysis__copy">
			<SectionHeading
				eyebrow="Análisis"
				title="No empezamos preguntando qué tecnología usar."
				description="Primero analizamos cómo funciona realmente la operación. La tecnología se elige después de comprender el problema."
				titleId="process-analysis-title"
			/>
		</div>

		<div class="process-analysis__diagram" aria-label="Elementos que TinKode analiza antes de seleccionar tecnología">
			<div class="process-analysis__core">
				<strong>Comprensión del negocio</strong>
				<span>Antes del código</span>
			</div>
			<div class="process-analysis__items">
				{
					analysisItems.map((item, index) => (
						<article class:list={["process-analysis-item", `process-analysis-item--${index + 1}`]}>
							<TechNode label={item.title} variant={item.variant} size="sm" active={index === 0 || index === 3}>
								<InlineIcon slot="icon" name={item.icon} />
							</TechNode>
							<p>{item.description}</p>
						</article>
					))
				}
			</div>
			<div class="process-analysis__result" aria-label="Resultado del análisis">
				<span>Problema comprendido</span>
				<span>Solución definida</span>
				<span>Tecnología seleccionada</span>
			</div>
		</div>
	</div>
</SectionBackground>
