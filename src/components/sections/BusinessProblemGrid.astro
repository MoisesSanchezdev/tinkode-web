---
import GlowIcon from "../ui/GlowIcon.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import VisualCard from "../ui/VisualCard.astro";

const problems = [
	{
		title: "Procesos manuales",
		description: "El equipo repite acciones que podrían fluir con menos intervención.",
		consequence: "Más errores",
		icon: "workflow",
		variant: "green",
	},
	{
		title: "Información dispersa",
		description: "Los datos viven en chats, hojas, notas y aplicaciones separadas.",
		consequence: "Tiempo perdido",
		icon: "database",
		variant: "blue",
	},
	{
		title: "Herramientas desconectadas",
		description: "Cada canal resuelve una parte, pero nada mantiene la operación alineada.",
		consequence: "Doble trabajo",
		icon: "integration",
		variant: "green",
	},
	{
		title: "Falta de control",
		description: "La información importante aparece tarde o depende de revisiones manuales.",
		consequence: "Menor visibilidad",
		icon: "control",
		variant: "blue",
	},
	{
		title: "Comunicación lenta",
		description: "Las solicitudes avanzan por confirmaciones manuales y mensajes repetidos.",
		consequence: "Respuestas lentas",
		icon: "message",
		variant: "green",
	},
	{
		title: "Tareas repetitivas",
		description: "El negocio invierte atención operativa en tareas de bajo valor.",
		consequence: "Dependencia manual",
		icon: "automation",
		variant: "blue",
	},
] as const;
---

<section class="solutions-problems solutions-page-section" aria-labelledby="solutions-problems-title">
	<div class="container">
		<SectionHeading
			eyebrow="Problemas operativos"
			title="Los problemas no siempre están en la tecnología."
			description="Muchas fricciones aparecen cuando los procesos son manuales, la información está dispersa o las herramientas no hablan entre sí."
			titleId="solutions-problems-title"
			class="solutions-problems__heading"
		/>

		<div class="solutions-problems__grid">
			{
				problems.map((problem, index) => (
					<Reveal delay={index > 2 ? "sm" : "none"}>
						<VisualCard interactive variant={problem.variant} class="solutions-problem-card">
							<div class="solutions-problem-card__header">
								<GlowIcon variant={problem.variant} size="md">
									<InlineIcon name={problem.icon} />
								</GlowIcon>
								<span>{problem.consequence}</span>
							</div>
							<div class="solutions-problem-card__body">
								<h3>{problem.title}</h3>
								<p>{problem.description}</p>
							</div>
						</VisualCard>
					</Reveal>
				))
			}
		</div>
	</div>
</section>
