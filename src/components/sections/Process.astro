---
import Button from "../ui/Button.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";

const steps = [
	{
		number: "01",
		title: "Entendemos",
		description: "Conversamos sobre el negocio, el problema y la forma actual de trabajar.",
	},
	{
		number: "02",
		title: "Diseñamos",
		description: "Definimos una solución clara, realista y conectada con la necesidad.",
	},
	{
		number: "03",
		title: "Construimos",
		description: "Desarrollamos y ajustamos por etapas para tomar decisiones visibles.",
	},
	{
		number: "04",
		title: "Evolucionamos",
		description: "La solución puede crecer cuando cambian las necesidades del negocio.",
	},
];
---

<section id="proceso" class="process-section section" aria-labelledby="process-title">
	<div class="container">
		<div class="section-header process-section__header">
			<p class="eyebrow">Cómo trabajamos</p>
			<h2 id="process-title">Primero entendemos. Después construimos.</h2>
			<p>
				No necesitas llegar con la solución definida. Empezamos entendiendo qué ocurre,
				qué necesitas mejorar y qué tendría sentido construir.
			</p>
		</div>

		<ol class="process-steps" aria-label="Etapas de trabajo de TinKode">
			{
				steps.map((step) => (
					<li class="process-step">
						<span class="process-step__number" aria-hidden="true">{step.number}</span>
						<div class="process-step__body">
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</div>
					</li>
				))
			}
		</ol>

		<aside class="process-closing" aria-label="Cierre de la forma de trabajo">
			<p>Cada proyecto comienza con una conversación, no con una plantilla.</p>
			<Button href={INSTAGRAM_URL} variant="ghost" external ariaLabel={`Hablemos de tu idea por ${INSTAGRAM_LABEL}`}>Hablemos de tu idea</Button>
		</aside>
	</div>
</section>
