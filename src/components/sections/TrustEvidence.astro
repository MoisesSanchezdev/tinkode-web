---
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import SurfaceCard from "../ui/SurfaceCard.astro";

const trustItems = [
	{
		title: "Participación directa",
		description: "Hablas con quienes analizan, deciden y construyen la solucion.",
		icon: "users",
	},
	{
		title: "Soluciones personalizadas",
		description: "No partimos de vender una plantilla; partimos de entender qué necesita cambiar.",
		icon: "control",
	},
	{
		title: "Comunicación clara",
		description: "Los avances, límites y decisiones se explican sin ocultar el estado real del proyecto.",
		icon: "message",
	},
	{
		title: "Documentacion",
		description: "La solución queda acompañada por referencias útiles para uso, mantenimiento y mejora.",
		icon: "form",
	},
	{
		title: "Validación constante",
		description: "Contrastamos lo construido con la necesidad real antes de seguir agregando complejidad.",
		icon: "clock",
	},
	{
		title: "Mejora continua",
		description: "Cada proyecto deja aprendizajes para refinar procesos, tecnologia y criterios de calidad.",
		icon: "workflow",
	},
] as const;
---

<SectionBackground variant="glow-green" class="about-page-section about-trust-premium" ariaLabelledby="about-trust-title">
	<div class="container about-trust-premium__grid">
		<Reveal class="about-trust-premium__heading">
			<SectionHeading
				eyebrow="Confianza"
				title="La confianza se construye en la forma de trabajar."
				titleId="about-trust-title"
				description="La relación con cada negocio se sostiene con claridad, participación real y decisiones visibles."
			/>
		</Reveal>

		<div class="about-trust-premium__items">
			{
				trustItems.map((item, index) => (
					<Reveal as="article" delay={index % 3 === 0 ? "sm" : "md"}>
						<SurfaceCard class="about-trust-card" padding="compact">
							<span class="about-trust-card__icon" aria-hidden="true"><InlineIcon name={item.icon} /></span>
							<div>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
							</div>
						</SurfaceCard>
					</Reveal>
				))
			}
		</div>
	</div>
</SectionBackground>
