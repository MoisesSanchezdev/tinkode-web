---
import { solutions } from "../../data/site";
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionIntro from "../ui/SectionIntro.astro";

interface Props {
	home?: boolean;
}

const { home = false } = Astro.props as Props;
---

<section id="soluciones" class="v2-section v2-solutions" aria-labelledby="v2-solutions-title">
	<div class="container">
		<div class="v2-section-heading-row">
			<SectionIntro
				eyebrow="Soluciones"
				title="Una solución útil empieza por el problema correcto."
				description="Combinamos estrategia, diseño e ingeniería para mejorar la forma en que el negocio se presenta, opera y crece."
				titleId="v2-solutions-title"
			/>
			{home && <Button href="/soluciones" variant="secondary">Explorar todas las soluciones</Button>}
		</div>

		<div class="v2-solutions__grid">
			{
				solutions.map((solution) => (
					<article class="v2-solution-card">
						<div class="v2-solution-card__top">
							<span>{solution.code}</span>
							<div><InlineIcon name={solution.icon} /></div>
						</div>
						<h3>{solution.title}</h3>
						<dl>
							<div>
								<dt>Problema</dt>
								<dd>{solution.problem}</dd>
							</div>
							<div>
								<dt>Beneficio</dt>
								<dd>{solution.benefit}</dd>
							</div>
						</dl>
						<p class="v2-solution-card__type">{solution.type}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
