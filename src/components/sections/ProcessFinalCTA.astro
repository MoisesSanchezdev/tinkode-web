---
import Button from "../ui/Button.astro";
import ConnectionLine from "../ui/ConnectionLine.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import TechNode from "../ui/TechNode.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
---

<section class="process-final-cta process-page-section" aria-labelledby="process-final-cta-title">
	<div class="container">
		<div class="process-final-cta__inner">
			<div class="process-final-cta__copy">
				<p class="eyebrow">Empecemos</p>
				<h2 id="process-final-cta-title">Una buena solución empieza entendiendo bien el problema.</h2>
				<p>Cuéntanos cómo funciona tu negocio y qué te gustaría mejorar.</p>
				<div class="process-final-cta__actions">
					<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>Hablemos</Button>
					<Button href="/proyectos" variant="ghost" size="large">Ver proyectos</Button>
				</div>
			</div>

			<div class="process-final-cta__visual" aria-label="Línea conceptual del proceso TinKode">
				<TechNode label="Conversación" variant="green" size="sm" active>
					<InlineIcon slot="icon" name="message" />
				</TechNode>
				<ConnectionLine variant="mixed" />
				<TechNode label="Diseño" variant="blue" size="sm">
					<InlineIcon slot="icon" name="interface" />
				</TechNode>
				<ConnectionLine variant="mixed" />
				<TechNode label="Solución" variant="green" size="sm" active>
					<InlineIcon slot="icon" name="software" />
				</TechNode>
			</div>
		</div>
	</div>
</section>
