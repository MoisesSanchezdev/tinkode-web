---
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechNode from "../ui/TechNode.astro";

const modules = [
	{ label: "Sitio web", icon: "website", variant: "blue" },
	{ label: "WhatsApp", icon: "whatsapp", variant: "green" },
	{ label: "Base de datos", icon: "database", variant: "green" },
	{ label: "Panel administrativo", icon: "interface", variant: "blue" },
	{ label: "NFC", icon: "nfc", variant: "green" },
	{ label: "Formularios", icon: "form", variant: "blue" },
	{ label: "Inventario", icon: "database", variant: "green" },
	{ label: "Reportes", icon: "report", variant: "blue" },
] as const;
---

<SectionBackground as="section" variant="glow-blue" class="home-ecosystem home-section" ariaLabelledby="home-ecosystem-title">
	<div class="container home-ecosystem__grid">
		<div class="home-ecosystem__copy">
			<SectionHeading
				eyebrow="Ecosistema"
				title="Todo funciona mejor cuando está conectado."
				description="Conectamos procesos, información y experiencias para construir soluciones que se adapten a la forma real de trabajar del negocio."
				titleId="home-ecosystem-title"
			/>
			<Button href="/soluciones" variant="secondary">Explorar soluciones</Button>
		</div>

		<div class="business-ecosystem" aria-label="Ecosistema tecnologico conectado para la operacion del negocio">
			<div class="business-ecosystem__core">
				<span>Operación del negocio</span>
				<small>Conectado</small>
			</div>
			<div class="business-ecosystem__orbit business-ecosystem__orbit--outer" aria-hidden="true"></div>
			<div class="business-ecosystem__orbit business-ecosystem__orbit--inner" aria-hidden="true"></div>
			<div class="business-ecosystem__modules">
				{
					modules.map((module, index) => (
						<div class:list={["business-ecosystem__module", `business-ecosystem__module--${index + 1}`]}>
							<TechNode label={module.label} variant={module.variant} size="sm" active={index === 1 || index === 2}>
								<InlineIcon slot="icon" name={module.icon} />
							</TechNode>
						</div>
					))
				}
			</div>
			<div class="business-ecosystem__states" aria-label="Estados del ecosistema">
				<span>Automatizado</span>
				<span>Organizado</span>
				<span>Escalable</span>
			</div>
		</div>
	</div>
</SectionBackground>
