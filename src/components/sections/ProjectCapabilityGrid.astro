---
import GlowIcon from "../ui/GlowIcon.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import VisualCard from "../ui/VisualCard.astro";

const capabilities = [
	{ title: "Análisis de problemas", detail: "Entender la necesidad antes de construir.", icon: "message", variant: "green" },
	{ title: "Modelado de procesos", detail: "Traducir operaciones en flujos claros.", icon: "workflow", variant: "blue" },
	{ title: "Arquitectura de información", detail: "Ordenar contenido, reglas y datos.", icon: "database", variant: "green" },
	{ title: "Frontend y experiencia", detail: "Interfaces legibles y responsive.", icon: "interface", variant: "blue" },
	{ title: "Backend y datos", detail: "Persistencia, validaciones y lógica.", icon: "software", variant: "green" },
	{ title: "Automatización", detail: "Reducir tareas manuales repetitivas.", icon: "automation", variant: "blue" },
	{ title: "Integración físico-digital", detail: "Conectar objetos con acciones web.", icon: "nfc", variant: "green" },
	{ title: "Documentación técnica", detail: "Dejar decisiones y funcionamiento claros.", icon: "report", variant: "blue" },
] as const;
---

<section class="projects-capabilities projects-page-section" aria-labelledby="projects-capabilities-title">
	<div class="container">
		<SectionHeading
			eyebrow="Capacidades demostradas"
			title="Los proyectos muestran más que interfaces."
			description="Cada caso deja ver una combinación distinta de análisis, producto, ingeniería y ejecución."
			titleId="projects-capabilities-title"
			class="projects-capabilities__heading"
		/>

		<div class="projects-capabilities__grid">
			{
				capabilities.map((capability, index) => (
					<Reveal delay={index > 3 ? "sm" : "none"}>
						<VisualCard interactive variant={capability.variant} padding="compact" class="projects-capability-card">
							<GlowIcon variant={capability.variant} size="md">
								<InlineIcon name={capability.icon} />
							</GlowIcon>
							<div>
								<h3>{capability.title}</h3>
								<p>{capability.detail}</p>
							</div>
						</VisualCard>
					</Reveal>
				))
			}
		</div>
	</div>
</section>
