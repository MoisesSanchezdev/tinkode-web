---
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const stages = [
	{ title: "Idea o necesidad", detail: "Se expresa el punto de mejora.", icon: "message" },
	{ title: "Flujo definido", detail: "La operación toma forma.", icon: "workflow" },
	{ title: "Prototipo", detail: "Las decisiones se vuelven visibles.", icon: "interface" },
	{ title: "Sistema funcional", detail: "La solución empieza a operar.", icon: "software" },
	{ title: "Mejora continua", detail: "El sistema evoluciona con el negocio.", icon: "automation" },
] as const;
---

<SectionBackground as="section" variant="glow-green" class="process-maturity process-page-section" ariaLabelledby="process-maturity-title">
	<div class="container">
		<SectionHeading
			eyebrow="De idea a sistema real"
			title="Una necesidad madura antes de convertirse en software."
			description="El objetivo no es saltar del problema al código, sino convertir una intención de negocio en una solución clara, validada y capaz de mejorar."
			titleId="process-maturity-title"
			class="process-maturity__heading"
		/>

		<ol class="process-maturity__stages" aria-label="Maduración de una solución tecnológica">
			{
				stages.map((stage, index) => (
					<li class:list={["process-maturity-stage", index === 2 && "is-featured"]}>
						<span class="process-maturity-stage__index">{String(index + 1).padStart(2, "0")}</span>
						<InlineIcon name={stage.icon} />
						<div>
							<h3>{stage.title}</h3>
							<p>{stage.detail}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</SectionBackground>
