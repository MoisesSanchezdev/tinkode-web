---
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import TechNode from "../ui/TechNode.astro";

const visionNodes = [
	{ label: "Ingeniería", variant: "green" },
	{ label: "Automatización", variant: "green" },
	{ label: "Software", variant: "blue" },
	{ label: "Escalabilidad", variant: "blue" },
	{ label: "Experiencias", variant: "green" },
	{ label: "Negocios", variant: "blue" },
] as const;
---

<SectionBackground variant="mixed" class="about-page-section about-vision" ariaLabelledby="about-vision-title">
	<div class="container about-vision__inner">
		<Reveal class="about-vision__copy">
			<p class="eyebrow">Visión</p>
			<h2 id="about-vision-title">Construir una empresa tecnológica que crezca junto a los negocios.</h2>
			<p>TinKode busca desarrollar soluciones útiles, escalables y bien pensadas para ayudar a negocios y organizaciones a evolucionar mediante ingeniería, software y automatización.</p>
			<div class="about-vision__nodes" aria-label="Areas de vision de TinKode">
				{visionNodes.map((node) => <TechNode label={node.label} variant={node.variant} size="sm" />)}
			</div>
		</Reveal>

		<Reveal class="about-vision__cta" delay="sm">
			<h3>Conversemos sobre lo que quieres construir.</h3>
			<p>Conoce nuestra forma de trabajar, revisa nuestros proyectos o cuéntanos qué proceso deseas mejorar.</p>
			<div class="about-vision__actions">
				<Button href={INSTAGRAM_URL} variant="primary" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>
					Hablemos
					<InlineIcon slot="icon-end" name="message" />
				</Button>
				<Button href="/proyectos" variant="secondary">
					Ver proyectos
					<InlineIcon slot="icon-end" name="arrow" />
				</Button>
			</div>
		</Reveal>
	</div>
</SectionBackground>
