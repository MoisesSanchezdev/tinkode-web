---
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import TechNode from "../ui/TechNode.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
---

<section class="solutions-final-cta solutions-page-section" aria-labelledby="solutions-final-cta-title">
	<div class="container">
		<div class="solutions-final-cta__inner">
			<div>
				<p class="eyebrow">Hablemos</p>
				<h2 id="solutions-final-cta-title">Tu negocio no necesita más herramientas. Necesita una mejor solución.</h2>
				<p>Cuéntanos qué proceso quieres mejorar y diseñaremos una solución alrededor de esa necesidad.</p>
			</div>
			<div class="solutions-final-cta__action">
				<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>Hablemos</Button>
				<div class="solutions-final-cta__nodes" aria-label="Enfoques de solución">
					<TechNode label="Procesos" variant="green" size="sm" active>
						<InlineIcon slot="icon" name="workflow" />
					</TechNode>
					<TechNode label="Información" variant="blue" size="sm">
						<InlineIcon slot="icon" name="database" />
					</TechNode>
					<TechNode label="Automatización" variant="green" size="sm">
						<InlineIcon slot="icon" name="automation" />
					</TechNode>
				</div>
			</div>
		</div>
	</div>
</section>
