---
import { PRIMARY_CONTACT_URL } from "../../data/contact";
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SystemVisual from "../ui/SystemVisual.astro";
---
<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="container home-hero__grid">
    <div class="home-hero__content">
      <p class="eyebrow" data-hero-reveal><span class="status-dot"></span> Ingeniería para tu siguiente etapa</p>
      <h1 id="home-hero-title" data-hero-reveal>Tu negocio.<br /><span>Mejor conectado.</span></h1>
      <p class="home-hero__description" data-hero-reveal>Diseñamos sitios, sistemas y automatizaciones que conectan lo que haces con lo que tu negocio puede llegar a ser.</p>
      <div class="home-hero__actions" data-hero-reveal>
        <Button href={PRIMARY_CONTACT_URL} size="large" external ariaLabel="Hablemos de tu negocio por WhatsApp">Hablemos de tu negocio <InlineIcon slot="icon-end" name="whatsapp" /></Button>
        <a class="text-link" href="/proyectos">Explorar proyectos <InlineIcon name="arrow" /></a>
      </div>
      <p class="home-hero__note" data-hero-reveal>De la necesidad real a una solución a medida.</p>
    </div>
    <SystemVisual />
  </div>
  <div class="container hero-rail" aria-label="Especialidades de TinKode">
    <span>TECNOLOGÍA CON PROPÓSITO</span><p><i></i> Presencia digital</p><p><i></i> Sistemas a medida</p><p><i></i> Automatización</p>
    <a href="#capacidades" aria-label="Descubrir qué hace TinKode"><span aria-hidden="true">↓</span></a>
  </div>
</section>
