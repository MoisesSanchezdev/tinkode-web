---
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
---

<section class="home-hero" aria-labelledby="home-hero-title">
	<div class="container home-hero__grid">
		<div class="home-hero__content">
			<h1 id="home-hero-title">Tecnología que hace avanzar tu negocio.</h1>
			<p>Creamos páginas, sistemas y automatizaciones claras, útiles y preparadas para crecer.</p>
			<div class="home-hero__actions" aria-label="Acciones principales">
				<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>
					Hablemos
					<InlineIcon slot="icon-end" name="arrow" />
				</Button>
				<Button href="/proyectos" variant="ghost" size="large">Ver proyectos</Button>
			</div>
		</div>

		<div class="home-hero__visual" aria-hidden="true">
			<div class="brand-orbit brand-orbit--outer"></div>
			<div class="brand-orbit brand-orbit--inner"></div>
			<span class="brand-node brand-node--green"></span>
			<span class="brand-node brand-node--blue"></span>
			<div class="brand-core">
				<img src="/images/brand/tinkode-symbol.png" alt="" width="192" height="192" decoding="async" />
			</div>
		</div>
	</div>
</section>
