---
import GlowIcon from "../ui/GlowIcon.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import VisualCard from "../ui/VisualCard.astro";

const scenarios = [
	{ title: "Restaurantes y cafeterías", detail: "Menús, reservas, inventario y atención conectada.", icon: "coffee", variant: "green" },
	{ title: "Clínicas y consultorios", detail: "Agendamiento, formularios, seguimiento y administración.", icon: "clinic", variant: "blue" },
	{ title: "Gimnasios", detail: "Planes, accesos, clientes y comunicaciones operativas.", icon: "fitness", variant: "green" },
	{ title: "Tiendas y comercio", detail: "Catálogos, pedidos, inventario y gestión de clientes.", icon: "store", variant: "blue" },
	{ title: "Profesionales independientes", detail: "Presencia digital, agenda, solicitudes y pagos guiados.", icon: "briefcase", variant: "green" },
	{ title: "Pymes y emprendimientos", detail: "Procesos internos, datos, reportes y automatización gradual.", icon: "workflow", variant: "blue" },
	{ title: "Eventos y organizaciones", detail: "Registros, accesos, comunicación y experiencias presenciales.", icon: "event", variant: "green" },
	{ title: "Bares y espacios de entretenimiento", detail: "Menús digitales, reservas, promociones y contacto rápido.", icon: "users", variant: "blue" },
] as const;
---

<section class="solutions-scenarios solutions-page-section" aria-labelledby="solutions-scenarios-title">
	<div class="container">
		<SectionHeading
			eyebrow="Escenarios"
			title="Estas soluciones pueden adaptarse a diferentes tipos de operación."
			description="Los escenarios son ejemplos de aplicación. Cada solución se define según el proceso real, no como una promesa genérica."
			titleId="solutions-scenarios-title"
			class="solutions-scenarios__heading"
		/>

		<div class="solutions-scenarios__grid">
			{
				scenarios.map((scenario, index) => (
					<Reveal delay={index > 3 ? "sm" : "none"}>
						<VisualCard interactive variant={scenario.variant} padding="compact" class="solutions-scenario-card">
							<GlowIcon variant={scenario.variant} size="md">
								<InlineIcon name={scenario.icon} />
							</GlowIcon>
							<div>
								<h3>{scenario.title}</h3>
								<p>{scenario.detail}</p>
							</div>
						</VisualCard>
					</Reveal>
				))
			}
		</div>
	</div>
</section>
