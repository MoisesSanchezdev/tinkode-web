---
import ConnectionLine from "../ui/ConnectionLine.astro";
import GlowIcon from "../ui/GlowIcon.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import Reveal from "../ui/Reveal.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import TechNode from "../ui/TechNode.astro";
import VisualCard from "../ui/VisualCard.astro";

const possibilities = [
	"Menús digitales",
	"Información para eventos",
	"Acceso rápido a contenido",
	"Experiencias en establecimientos",
	"Actualización centralizada",
] as const;
---

<SectionBackground as="section" variant="glow-blue" class="projects-nfc projects-page-section" ariaLabelledby="project-nfc-title">
	<div class="container projects-nfc__grid">
		<Reveal class="projects-nfc__copy">
			<SectionHeading
				eyebrow="Concepto tecnológico en desarrollo"
				title="NFC Smart Experience"
				description="Exploración de experiencias que conectan elementos físicos con contenido y procesos digitales mediante NFC."
				titleId="project-nfc-title"
			/>
			<div class="projects-case__story">
				<div>
					<span>Problema explorado</span>
					<p>Muchos puntos de contacto físicos obligan al usuario a buscar información o realizar procesos de manera poco directa.</p>
				</div>
				<div>
					<span>Exploración</span>
					<p>Utilizar NFC para abrir experiencias digitales desde stickers, tarjetas o manillas.</p>
				</div>
				<div>
					<span>Estado</span>
					<p>Proyecto en desarrollo.</p>
				</div>
			</div>
			<div class="projects-chip-list" aria-label="Posibilidades de NFC Smart Experience">
				{possibilities.map((item) => <span>{item}</span>)}
			</div>
		</Reveal>

		<Reveal delay="sm">
			<VisualCard variant="mixed" class="nfc-flow-card" as="div">
				<div class="nfc-flow-card__status">
					<GlowIcon variant="green" size="sm">
						<InlineIcon name="nfc" />
					</GlowIcon>
					<span>En desarrollo</span>
				</div>
				<div class="nfc-flow-card__flow" aria-label="Flujo conceptual objeto físico, toque NFC y experiencia digital">
					<TechNode label="Objeto físico" variant="green" size="sm" active>
						<InlineIcon slot="icon" name="nfc" />
					</TechNode>
					<ConnectionLine variant="mixed" />
					<TechNode label="Toque NFC" variant="blue" size="sm">
						<InlineIcon slot="icon" name="link" />
					</TechNode>
					<ConnectionLine variant="mixed" />
					<TechNode label="Experiencia digital" variant="green" size="sm" active>
						<InlineIcon slot="icon" name="website" />
					</TechNode>
				</div>
				<div class="nfc-flow-card__phone" aria-hidden="true">
					<span>Contenido actualizable</span>
					<strong>Menú · Evento · Información</strong>
					<small>Acción desde el celular</small>
				</div>
			</VisualCard>
		</Reveal>
	</div>
</SectionBackground>
