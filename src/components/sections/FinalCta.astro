---
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Construyamos algo útil para tu negocio.",
	description = "Cuéntanos qué quieres mejorar.",
} = Astro.props as Props;
---

<section class="final-cta" aria-labelledby="final-cta-title">
	<div class="container final-cta__inner">
		<div>
			<h2 id="final-cta-title">{title}</h2>
			<p>{description}</p>
		</div>
		<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>
			Hablemos por Instagram
			<InlineIcon slot="icon-end" name="arrow" />
		</Button>
	</div>
</section>
