---
import Button from "../ui/Button.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import TechNode from "../ui/TechNode.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";
---

<SectionBackground as="section" variant="mixed" class="home-final-cta home-section" ariaLabelledby="home-final-cta-title">
	<div class="container">
		<div class="home-final-cta__inner">
			<div>
				<p class="eyebrow">Conversemos</p>
				<h2 id="home-final-cta-title">Construyamos algo que realmente funcione.</h2>
				<p>Cuéntanos qué quieres mejorar en tu negocio y diseñaremos una solución alrededor de ese problema.</p>
			</div>
			<div class="home-final-cta__action">
				<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>
					Hablemos
					<InlineIcon slot="icon-end" name="arrow" />
				</Button>
				<div class="home-final-cta__nodes" aria-label="Enfoque de la conversacion">
					<TechNode label="Problema" variant="green" size="sm" active />
					<TechNode label="Proceso" variant="blue" size="sm" />
					<TechNode label="Solucion" variant="green" size="sm" />
				</div>
			</div>
		</div>
	</div>
</SectionBackground>
