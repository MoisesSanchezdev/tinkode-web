---
import { founders } from "../../data/site";
import InlineIcon from "../ui/InlineIcon.astro";
interface Props { home?: boolean; }
const { home = false } = Astro.props;
---

<section class="section founders" aria-labelledby="founders-title">
	<div class="container">
		<div class="section-heading section-heading--split" data-reveal>
			<div><p class="eyebrow">{home ? "05 / Las personas detrás" : "Equipo fundador"}</p>
			<h2 id="founders-title">Ingeniería con nombre propio.</h2></div>
			{home && <a class="text-link" href="/nosotros">Conoce a TinKode <InlineIcon name="arrow" /></a>}
		</div>

		<div class="founders__list" data-stagger>
			{
				founders.map((founder) => (
					<article id={founder.name.startsWith("Moisés") ? "moises-sanchez-naranjo" : "valeria-lopez-chavez"} class={`founder founder--${founder.accent}`}>
						<div class="founder__identity">
							<span aria-hidden="true">{founder.initials}</span>
							<div><small>{founder.role}</small><h3>{founder.name}</h3></div>
						</div>
						{!home && <p>{founder.description}</p>}
						<p class="founder__study"><strong>{founder.study}</strong><span>{founder.institution}</span></p>
					</article>
				))
			}
		</div>
	</div>
</section>
