---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import ConnectionLine from "../ui/ConnectionLine.astro";
import InlineIcon from "../ui/InlineIcon.astro";
import SectionBackground from "../ui/SectionBackground.astro";
import TechNode from "../ui/TechNode.astro";
import { INSTAGRAM_LABEL, INSTAGRAM_URL } from "../../data/contact";

const inputs = [
	{ label: "Necesidad", icon: "message" },
	{ label: "Fricción", icon: "control" },
	{ label: "Información", icon: "database" },
	{ label: "Personas", icon: "users" },
	{ label: "Proceso", icon: "workflow" },
] as const;

const layers = ["Análisis", "Diseño", "Construcción", "Validación"] as const;

const outputs = [
	{ label: "Sistema", icon: "software" },
	{ label: "Automatización", icon: "automation" },
	{ label: "Experiencia", icon: "website" },
	{ label: "Evolución", icon: "arrow" },
] as const;
---

<SectionBackground as="section" variant="mixed" class="process-hero" ariaLabelledby="process-hero-title">
	<div class="container process-hero__grid">
		<div class="process-hero__content">
			<Badge variant="accent">Cómo trabajamos</Badge>
			<div class="process-hero__copy">
				<h1 id="process-hero-title">Entendemos el problema antes de construir la solución.</h1>
				<p>
					Analizamos procesos, personas e información para diseñar tecnología que tenga sentido dentro del negocio.
				</p>
			</div>
			<div class="process-hero__actions" aria-label="Acciones principales">
				<Button href={INSTAGRAM_URL} variant="primary" size="large" external ariaLabel={`Hablemos por ${INSTAGRAM_LABEL}`}>Hablemos</Button>
				<Button href="/proyectos" variant="ghost" size="large">Ver proyectos</Button>
			</div>
		</div>

		<div class="process-hero-visual" aria-label="Flujo conceptual desde necesidad de negocio hasta solución organizada">
			<div class="process-hero-visual__input">
				<span class="process-hero-visual__label">Entrada</span>
				<div class="process-hero-visual__input-grid">
					{
						inputs.map((item, index) => (
							<TechNode label={item.label} variant={index % 2 === 0 ? "green" : "blue"} size="sm">
								<InlineIcon slot="icon" name={item.icon} />
							</TechNode>
						))
					}
				</div>
			</div>

			<div class="process-hero-visual__layers" aria-hidden="true">
				{layers.map((layer, index) => <span style={`--layer-index: ${index}`}>{layer}</span>)}
			</div>

			<ConnectionLine class="process-hero-visual__line" variant="mixed" />

			<div class="process-hero-visual__output">
				<span class="process-hero-visual__label">Salida</span>
				<div class="process-hero-visual__output-grid">
					{
						outputs.map((item, index) => (
							<TechNode label={item.label} variant={index % 2 === 0 ? "blue" : "green"} size="sm" active={index < 2}>
								<InlineIcon slot="icon" name={item.icon} />
							</TechNode>
						))
					}
				</div>
			</div>
		</div>
	</div>
</SectionBackground>
